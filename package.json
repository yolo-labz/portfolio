{
	"name": "@portfolio/root",
	"private": true,
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=22.6.0"
	},
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "biome check . && node scripts/voice-lint.mjs && node scripts/check-no-em-dash.mjs && node --experimental-strip-types scripts/check-retirement.mjs && node scripts/check-client-namespaces.mjs && node scripts/test-public-repo-links.mjs && node scripts/check-public-repo-links.mjs && node scripts/test-design-tokens.mjs && node scripts/check-design-tokens.mjs",
		"lint:fix": "biome check --write .",
		"lint:voice": "node scripts/voice-lint.mjs",
		"format": "biome format --write .",
		"typecheck": "turbo typecheck",
		"clean": "turbo clean && rm -rf node_modules",
		"test:retirement": "node --experimental-strip-types scripts/check-retirement.mjs && node scripts/test-retirement.mjs",
		"test:visual": "playwright test",
		"test:visual:update": "playwright test --update-snapshots",
		"test:visual:report": "playwright show-report test-results/playwright-report"
	},
	"pnpm": {
		"overrides": {
			"nanoid@<3.3.18": "3.3.20",
			"postcss@<8.5.23": "8.5.23"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@playwright/test": "1.65.0",
		"@types/node": "26.6.6",
		"turbo": "2.11.10",
		"typescript": "6.0.3"
	}
}
